/-!
# IntentoSu.lean — the unity sufficiency S_u of original Q: what premises of
# the form "u depends only on κ" can and cannot deliver.

Lean 4 core (4.24.0), no Mathlib. Abstract types only: D = realizations of a
declared domain, V = descriptor values, U = degree values. Nothing here selects
Φ_Q, the domain, the degree u_orig or its comparison relation; no physical or
phenomenal premise is validated by compiling this file.

Main results
* `entails_Su_iff` : premises "u agrees on R-related pairs" entail S_u for every
  compatible u  ⟺  ker Φ ⊆ the equivalence generated by R.
* `nonconstant_iff` : those premises leave room for a non-constant u ⟺ the
  generated equivalence is not total.
* `saturated` : if they entail S_u, every generated class is a union of Φ-fibres.
* `connected_forces_constant` : u factoring through κ, S_u, and a connected
  co-occurrence relation (same κ or same Φ) force u to be constant.
* `oi_residual` : under OI and Adm, S_u ⟺ equality of u on the non-isomorphic
  pairs with equal Φ (the cross-class residual).
* `robust_iff_relational` : S_u for every representation ψ of the coexperience
  structure (with an injective one available) ⟺ relational sufficiency.
* Finite countermodels showing each hypothesis is needed.
-/

namespace IntentoSu

/-- Scalar sufficiency of `u` with respect to `Φ`. -/
def Suff {D V U : Type} (Φ : D → V) (u : D → U) : Prop :=
  ∀ s t, Φ s = Φ t → u s = u t

/-- Equivalence closure of a relation (defined here; no Mathlib). -/
inductive Eqv {D : Type} (R : D → D → Prop) : D → D → Prop
  | rel {a b : D} : R a b → Eqv R a b
  | refl (a : D) : Eqv R a a
  | symm {a b : D} : Eqv R a b → Eqv R b a
  | trans {a b c : D} : Eqv R a b → Eqv R b c → Eqv R a c

/-- `u` respects every premise "equal on R-related pairs". -/
def Respects {D U : Type} (R : D → D → Prop) (u : D → U) : Prop :=
  ∀ a b, R a b → u a = u b

theorem respects_eqv {D U : Type} {R : D → D → Prop} {u : D → U}
    (h : Respects R u) : ∀ a b, Eqv R a b → u a = u b := by
  intro a b hab
  induction hab with
  | rel hr => exact h _ _ hr
  | refl _ => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

/-- The Prop-valued class indicator of `t`; it respects `R` (uses propext). -/
theorem indicator_respects {D : Type} (R : D → D → Prop) (t : D) :
    Respects R (fun x => Eqv R t x) := by
  intro a b hab
  apply propext
  constructor
  · intro h; exact Eqv.trans h (Eqv.rel hab)
  · intro h; exact Eqv.trans h (Eqv.symm (Eqv.rel hab))

/-- Premises of the form "u depends only on R-related data" entail S_u for every
compatible `u` (valued in any type) iff every Φ-fibre lies in one class of the
generated equivalence. -/
theorem entails_Su_iff {D V : Type} (R : D → D → Prop) (Φ : D → V) :
    (∀ (U : Type) (u : D → U), Respects R u → Suff Φ u) ↔
      (∀ s t, Φ s = Φ t → Eqv R s t) := by
  constructor
  · intro h s t hst
    have key : Eqv R t s = Eqv R t t := h Prop (fun x => Eqv R t x) (indicator_respects R t) s t hst
    have ht : Eqv R t t := Eqv.refl t
    have hs : Eqv R t s := by rw [key]; exact ht
    exact Eqv.symm hs
  · intro h U u hu s t hst
    exact respects_eqv hu s t (h s t hst)

/-- The premises leave room for a non-constant compatible `u` iff the generated
equivalence is not total. -/
theorem nonconstant_iff {D : Type} (R : D → D → Prop) :
    (∃ (U : Type) (u : D → U), Respects R u ∧ ∃ a b, u a ≠ u b) ↔
      ¬ (∀ a b, Eqv R a b) := by
  constructor
  · intro ⟨U, u, hu, a, b, hne⟩ hall
    exact hne (respects_eqv hu a b (hall a b))
  · intro hnot
    apply Classical.byContradiction
    intro hno
    apply hnot
    intro a b
    apply Classical.byContradiction
    intro hab
    apply hno
    refine ⟨Prop, fun x => Eqv R a x, indicator_respects R a, a, b, ?_⟩
    intro heq
    have : Eqv R a b := by
      have h1 : (fun x => Eqv R a x) a := Eqv.refl a
      simp only at h1 heq
      rw [← heq]; exact h1
    exact hab this

/-- If the premises entail S_u, each generated class is a union of Φ-fibres. -/
theorem saturated {D V : Type} (R : D → D → Prop) (Φ : D → V)
    (h : ∀ s t, Φ s = Φ t → Eqv R s t) :
    ∀ s s' t, Φ s' = Φ s → Eqv R s t → Eqv R s' t := by
  intro s s' t hΦ hst
  exact Eqv.trans (h s' s hΦ) hst

/-- Co-occurrence: same κ-class or same descriptor value. -/
def CoOcc {D K V : Type} (κ : D → K) (Φ : D → V) (a b : D) : Prop :=
  κ a = κ b ∨ Φ a = Φ b

/-- If `u` factors through `κ` and satisfies S_u, and the co-occurrence relation
connects every pair, then `u` is constant. -/
theorem connected_forces_constant {D K V U : Type} (κ : D → K) (Φ : D → V)
    (f : K → U) (u : D → U) (hfac : ∀ x, u x = f (κ x)) (hS : Suff Φ u)
    (hconn : ∀ a b, Eqv (CoOcc κ Φ) a b) : ∀ a b, u a = u b := by
  have hres : Respects (CoOcc κ Φ) u := by
    intro a b h
    cases h with
    | inl hk => rw [hfac a, hfac b, hk]
    | inr hp => exact hS a b hp
  intro a b
  exact respects_eqv hres a b (hconn a b)

/-- Converse direction of the dichotomy: a constant `u` satisfies S_u. -/
theorem constant_suff {D V U : Type} (Φ : D → V) (u : D → U)
    (hc : ∀ a b, u a = u b) : Suff Φ u := fun a b _ => hc a b

/-- Under OI (isomorphic ⇒ equal u) and Adm (isomorphic ⇒ equal Φ), S_u is
equivalent to equality of `u` on the non-isomorphic pairs with equal Φ. -/
theorem oi_residual {D V U : Type} (iso : D → D → Prop) (Φ : D → V) (u : D → U)
    (hOI : ∀ s t, iso s t → u s = u t) :
    Suff Φ u ↔ (∀ s t, Φ s = Φ t → ¬ iso s t → u s = u t) := by
  constructor
  · intro h s t hst _; exact h s t hst
  · intro h s t hst
    by_cases hi : iso s t
    · exact hOI s t hi
    · exact h s t hst hi

/-- With an injective representation available, S_u for every representation
`ψ ∘ 𝔘` of the coexperience structure is equivalent to relational sufficiency
(Φ determines the structure). -/
theorem robust_iff_relational {D V H U : Type} (Φ : D → V) (𝔘 : D → H)
    (ψ₀ : H → U) (hinj : ∀ x y, ψ₀ x = ψ₀ y → x = y) :
    (∀ ψ : H → U, Suff Φ (fun s => ψ (𝔘 s))) ↔ Suff Φ 𝔘 := by
  constructor
  · intro h s t hst
    exact hinj _ _ (h ψ₀ s t hst)
  · intro h ψ s t hst
    show ψ (𝔘 s) = ψ (𝔘 t)
    rw [h s t hst]

/-! ## Finite countermodels (kernel-checked by `decide`) -/

/-- CM1. OI and Adm hold, S_u fails: two non-isomorphic realizations with equal
Φ and different u. OI covers only isomorphism classes. -/
def cm1Φ : Fin 2 → Nat := fun _ => 1
def cm1u : Fin 2 → Nat := fun s => s.val
def cm1iso : Fin 2 → Fin 2 → Prop := fun a b => a = b
theorem cm1_OI : ∀ s t : Fin 2, cm1iso s t → cm1u s = cm1u t := by
  intro s t h; rw [h]
theorem cm1_Adm : ∀ s t : Fin 2, cm1iso s t → cm1Φ s = cm1Φ t := by
  intro s t _; rfl
theorem cm1_not_Su : ¬ Suff cm1Φ cm1u := by
  intro h; have := h 0 1 rfl; simp [cm1u] at this

/-- CM2. Transversal κ with product image (co-occurrence connected): u factors
through κ, is non-constant, and S_u fails. -/
def cm2Φ : Fin 4 → Nat := fun s => s.val / 2
def cm2κ : Fin 4 → Nat := fun s => s.val % 2
def cm2u : Fin 4 → Nat := fun s => cm2κ s
theorem cm2_factor : ∀ x, cm2u x = id (cm2κ x) := fun _ => rfl
theorem cm2_not_Su : ¬ Suff cm2Φ cm2u := by
  intro h; have := h 0 1 rfl; simp [cm2u, cm2κ] at this

/-- CM3. Segregation: κ aligned with Φ-levels (κ is a function of Φ). u factors
through κ, is non-constant, and S_u holds; co-occurrence is disconnected. -/
def cm3Φ : Fin 4 → Nat := fun s => s.val / 2
def cm3κ : Fin 4 → Nat := fun s => s.val / 2
def cm3u : Fin 4 → Nat := fun s => cm3κ s
theorem cm3_Su : Suff cm3Φ cm3u := by
  intro s t h; simp only [cm3u, cm3κ]; simp only [cm3Φ] at h; exact h
theorem cm3_nonconstant : cm3u 0 ≠ cm3u 2 := by decide

/-- CM4. Relational sufficiency fails: equal Φ, two different coexperience
structures; with an injective ψ, S_u fails. -/
def cm4Φ : Fin 2 → Nat := fun _ => 1
def cm4𝔘 : Fin 2 → Nat := fun s => s.val   -- codes of two structures
theorem cm4_not_rel : ¬ Suff cm4Φ cm4𝔘 := by
  intro h; have := h 0 1 rfl; simp [cm4𝔘] at this

end IntentoSu

#print axioms IntentoSu.entails_Su_iff
#print axioms IntentoSu.nonconstant_iff
#print axioms IntentoSu.saturated
#print axioms IntentoSu.connected_forces_constant
#print axioms IntentoSu.constant_suff
#print axioms IntentoSu.oi_residual
#print axioms IntentoSu.robust_iff_relational
#print axioms IntentoSu.cm1_not_Su
#print axioms IntentoSu.cm2_not_Su
#print axioms IntentoSu.cm3_Su
#print axioms IntentoSu.cm3_nonconstant
#print axioms IntentoSu.cm4_not_rel

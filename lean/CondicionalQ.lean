/-!
# CondicionalQ.lean — a conditional theorem for the obligations S_c, S_q, S_u, S_τ, S_σ,
# the order clause B and the descent condition O of the original Q, without altering Q.

Lean 4 core (4.24.0), no Mathlib. Abstract types only: `D` = realizations of the
original domain D_0; for a component `i`, `C i` = its values and `W i` = the values of
its reduced input `d i`. Nothing here selects D_0, γ, Φ_Q, ψ, the reading of 𝒞 or the
physical equivalence ∼_phys, and no physical or phenomenal premise is validated by
compiling this file. Joint admissibility and the process obligations of Q are not
formalized: the paper gives them no formal statement.

Part (i), sufficiency component by component
* `suff_of_cover`: bridge premise (y respects R) and coverage (ker d ⊆ ⟨R⟩) give S.
* `coverage_iff`: for values in any type with two distinct elements, "y respects R"
  entails S for every such y iff ker d ⊆ ⟨R⟩ (Theorem 19 of the paper, per component,
  without the Prop-valued indicator).
* `aligned_cover_iff`: an equivalence relation inside ker d covers ker d iff it is ker d
  (Theorem 15 of the paper, per component).
* `pointed_reading_kernel`, `Sq_pointed`: if 𝒞 is read as the pointed isomorphism class,
  ker d_q is the isomorphism relation, and S_q follows from isomorphism invariance of q.
Part (ii), unity through the coexperience structure
* `rel_suff_all_psi`, `cover_structures`, `robust_iff_relational` (Theorem 23, restated),
  `single_psi_example` (one ψ suffices without relational sufficiency, u not constant).
Part (iii), order
* `order_cover_Su_iff`, `order_cover_B_iff`, `order_cover_SuB_iff`: premises
  "y does not decrease along P" entail S_u, B, S_u ∧ B for every such y iff the kernel,
  the strict order, the non-strict order of Φ lie in the reflexive-transitive closure P*.
* `theorem19_from_order`: with P the symmetric closure of R this is Theorem 19.
* `suff_and_B_iff_nonstrict` (Definition 5(a)), `orderB_iff_monotone_factor`,
  `suffB_iff_monotone_factor` (Definition 5(b)), `suff_iff_factor` (Definition 3(e)).
Part (iv), interventions
* `im_Su_iff_injective`: IM_T entails S_u for every compatible degree iff Φ is injective.
* `im_B_iff`: IM_T entails B for every compatible degree iff every strict increase of Φ
  is a chain of Φ-raising pairs of T.
Part (v), descent
* `descent_of_suff`, `descent_componentwise`, `descent_exact_iff`,
  `descent_needs_invariance`, `descent_iff_factor`.
Assembly
* `conditional_discharge`: the premises together give the S_i, B and O.
-/

namespace CondicionalQ

open Classical

/-! ## Basic notions -/

/-- Sufficiency of `y` with respect to `d`: equal values of `d` force equal values of `y`. -/
def Suff {D V X : Type} (d : D → V) (y : D → X) : Prop :=
  ∀ s t, d s = d t → y s = y t

/-- `y` respects `R`: R-related realizations have equal values of `y` (a bridge premise). -/
def Respects {D X : Type} (R : D → D → Prop) (y : D → X) : Prop :=
  ∀ s t, R s t → y s = y t

/-- The equivalence relation ⟨R⟩ generated by `R` (as in IntentoSu.lean). -/
inductive Eqv {D : Type} (R : D → D → Prop) : D → D → Prop
  | rel {a b : D} : R a b → Eqv R a b
  | refl (a : D) : Eqv R a a
  | symm {a b : D} : Eqv R a b → Eqv R b a
  | trans {a b c : D} : Eqv R a b → Eqv R b c → Eqv R a c

theorem respects_eqv {D X : Type} {R : D → D → Prop} {y : D → X}
    (h : Respects R y) : ∀ a b, Eqv R a b → y a = y b := by
  intro a b hab
  induction hab with
  | rel hr => exact h _ _ hr
  | refl _ => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih1 ih2 => exact ih1.trans ih2

/-! ## Part (i): sufficiency, component by component -/

/-- Bridge premise plus coverage give sufficiency. -/
theorem suff_of_cover {D V X : Type} (R : D → D → Prop) (d : D → V) (y : D → X)
    (hbridge : Respects R y) (hcover : ∀ s t, d s = d t → Eqv R s t) : Suff d y :=
  fun s t hst => respects_eqv hbridge s t (hcover s t hst)

/-- Coverage criterion, for values in any type with two distinct elements `a ≠ b`:
"y respects R" entails S for every such `y` iff every fibre of `d` lies in one class
of ⟨R⟩. -/
theorem coverage_iff {D V X : Type} (R : D → D → Prop) (d : D → V) (a b : X)
    (hab : a ≠ b) :
    (∀ y : D → X, Respects R y → Suff d y) ↔ (∀ s t, d s = d t → Eqv R s t) := by
  constructor
  · intro h s t hst
    have hresp : Respects R (fun r => if Eqv R t r then a else b) := by
      intro r r' hrr'
      show (if Eqv R t r then a else b) = (if Eqv R t r' then a else b)
      by_cases h1 : Eqv R t r
      · have h2 : Eqv R t r' := Eqv.trans h1 (Eqv.rel hrr')
        rw [if_pos h1, if_pos h2]
      · have h2 : ¬ Eqv R t r' := fun h2 => h1 (Eqv.trans h2 (Eqv.symm (Eqv.rel hrr')))
        rw [if_neg h1, if_neg h2]
    have hs : (if Eqv R t s then a else b) = (if Eqv R t t then a else b) :=
      h _ hresp s t hst
    by_cases hts : Eqv R t s
    · exact Eqv.symm hts
    · exfalso
      rw [if_neg hts, if_pos (Eqv.refl t)] at hs
      exact hab hs.symm
  · intro h y hy
    exact suff_of_cover R d y hy h

/-- If `R` is an equivalence relation contained in ker d (an aligned feature), coverage
holds iff `R` is exactly ker d. -/
theorem aligned_cover_iff {D V : Type} (R : D → D → Prop) (d : D → V)
    (hrefl : ∀ a, R a a) (hsymm : ∀ a b, R a b → R b a)
    (htrans : ∀ a b c, R a b → R b c → R a c)
    (hal : ∀ s t, R s t → d s = d t) :
    (∀ s t, d s = d t → Eqv R s t) ↔ (∀ s t, d s = d t ↔ R s t) := by
  have hE : ∀ a b, Eqv R a b → R a b := by
    intro a b h
    induction h with
    | rel hr => exact hr
    | refl x => exact hrefl x
    | symm _ ih => exact hsymm _ _ ih
    | trans _ _ ih1 ih2 => exact htrans _ _ _ ih1 ih2
  constructor
  · intro h s t
    exact ⟨fun hd => hE s t (h s t hd), hal s t⟩
  · intro h s t hd
    exact Eqv.rel ((h s t).1 hd)

/-- The quality component under the reading of 𝒞 as the pointed isomorphism class at
grain γ (an open decision of Q): with Adm (isomorphic ⇒ equal Φ), the kernel of
d_q = (Φ_Q, 𝒞) is the isomorphism relation itself. -/
theorem pointed_reading_kernel {D V K : Type} (Φ : D → V) (𝒞 : D → K)
    (iso : D → D → Prop) (hC : ∀ s t, 𝒞 s = 𝒞 t ↔ iso s t)
    (hAdm : ∀ s t, iso s t → Φ s = Φ t) :
    ∀ s t, (Φ s, 𝒞 s) = (Φ t, 𝒞 t) ↔ iso s t := by
  intro s t
  constructor
  · intro h
    exact (hC s t).1 (congrArg Prod.snd h)
  · intro h
    rw [hAdm s t h, (hC s t).2 h]

/-- Under that reading, S_q follows from the bridge "isomorphic realizations have equal
q" (what OI_γ yields on pairs with a conscious member); coverage holds with R = iso. -/
theorem Sq_pointed {D V K X : Type} (Φ : D → V) (𝒞 : D → K) (q : D → X)
    (iso : D → D → Prop) (hC : ∀ s t, 𝒞 s = 𝒞 t ↔ iso s t)
    (hAdm : ∀ s t, iso s t → Φ s = Φ t) (hbridge : Respects iso q) :
    Suff (fun s => (Φ s, 𝒞 s)) q :=
  suff_of_cover iso (fun s => (Φ s, 𝒞 s)) q hbridge
    (fun s t h => Eqv.rel ((pointed_reading_kernel Φ 𝒞 iso hC hAdm s t).1 h))

/-! ## Part (ii): unity through the coexperience structure (under B_ψ: u = ψ ∘ 𝔘) -/

/-- Relational sufficiency (Φ determines the structure) gives S_u for every comparison ψ. -/
theorem rel_suff_all_psi {D V H U : Type} (Φ : D → V) (𝔘 : D → H)
    (hrel : Suff Φ 𝔘) (ψ : H → U) : Suff Φ (fun s => ψ (𝔘 s)) := by
  intro s t hst
  show ψ (𝔘 s) = ψ (𝔘 t)
  rw [hrel s t hst]

/-- A relation that the structure respects and that covers ker Φ gives relational
sufficiency. -/
theorem cover_structures {D V H : Type} (R : D → D → Prop) (Φ : D → V) (𝔘 : D → H)
    (hR : Respects R 𝔘) (hcover : ∀ s t, Φ s = Φ t → Eqv R s t) : Suff Φ 𝔘 :=
  suff_of_cover R Φ 𝔘 hR hcover

/-- Theorem 23 of the paper, restated: with an injective comparison ψ₀, S_u for every ψ
is equivalent to relational sufficiency. -/
theorem robust_iff_relational {D V H U : Type} (Φ : D → V) (𝔘 : D → H)
    (ψ₀ : H → U) (hinj : ∀ x y, ψ₀ x = ψ₀ y → x = y) :
    (∀ ψ : H → U, Suff Φ (fun s => ψ (𝔘 s))) ↔ Suff Φ 𝔘 := by
  constructor
  · intro h s t hst
    exact hinj _ _ (h ψ₀ s t hst)
  · intro h ψ
    exact rel_suff_all_psi Φ 𝔘 h ψ

/-- A single comparison ψ can give S_u without relational sufficiency, with u = ψ ∘ 𝔘
not constant: three realizations, Φ = 0, 0, 1, three distinct structures, ψ = 0, 0, 1. -/
def exΦ : Fin 3 → Nat := fun s => if s.val = 2 then 1 else 0
def ex𝔘 : Fin 3 → Nat := fun s => s.val
def exψ : Nat → Nat := fun h => if h = 2 then 1 else 0

theorem single_psi_example :
    Suff exΦ (fun s => exψ (ex𝔘 s)) ∧ ¬ Suff exΦ ex𝔘 ∧ exψ (ex𝔘 0) ≠ exψ (ex𝔘 2) := by
  refine ⟨?_, ?_, ?_⟩
  · intro s t h
    exact h
  · intro h
    have h01 : ex𝔘 0 = ex𝔘 1 := h 0 1 (by decide)
    exact absurd h01 (by decide)
  · decide

/-! ## Part (iii): order -/

/-- A scale of degree values: a partial order with two strictly ordered elements
(for the real degrees of the paper: ≤ on ℝ, with 0 and 1). -/
structure Scale (U : Type) where
  le : U → U → Prop
  le_refl : ∀ a, le a a
  le_trans : ∀ a b c, le a b → le b c → le a c
  le_antisymm : ∀ a b, le a b → le b a → a = b
  lo : U
  hi : U
  lo_le_hi : le lo hi
  not_hi_le_lo : ¬ le hi lo

/-- The integers form a scale (non-vacuity in core Lean). -/
def intScale : Scale Int where
  le := fun a b => a ≤ b
  le_refl := Int.le_refl
  le_trans := fun _ _ _ h1 h2 => Int.le_trans h1 h2
  le_antisymm := fun _ _ h1 h2 => Int.le_antisymm h1 h2
  lo := 0
  hi := 1
  lo_le_hi := by show (0 : Int) ≤ 1; decide
  not_hi_le_lo := by show ¬ (1 : Int) ≤ 0; decide

/-- Reflexive-transitive closure P* (as in ViaFutura.lean). -/
inductive Chain {D : Type} (P : D → D → Prop) : D → D → Prop
  | refl (a : D) : Chain P a a
  | step {a b c : D} : Chain P a b → P b c → Chain P a c

theorem chain_trans {D : Type} {P : D → D → Prop} {a b c : D}
    (h1 : Chain P a b) (h2 : Chain P b c) : Chain P a c := by
  induction h2 with
  | refl => exact h1
  | step _ hP ih => exact Chain.step ih hP

theorem chain_prepend {D : Type} {P : D → D → Prop} {a b c : D}
    (hab : P a b) (h : Chain P b c) : Chain P a c :=
  chain_trans (Chain.step (Chain.refl a) hab) h

/-- `y` does not decrease along `P` (a premise of order type). -/
def MonoAlong {D U : Type} (S : Scale U) (P : D → D → Prop) (y : D → U) : Prop :=
  ∀ s t, P s t → S.le (y s) (y t)

/-- The order clause B, with `lt` the strict order of descriptor values. -/
def OrderB {D V U : Type} (S : Scale U) (lt : V → V → Prop) (Φ : D → V) (y : D → U) :
    Prop :=
  ∀ s t, lt (Φ s) (Φ t) → S.le (y s) (y t)

/-- The non-strict implication of Definition 5(a): Φ s ≤ Φ t ⇒ y s ≤ y t, with
Φ s ≤ Φ t read as Φ s < Φ t or Φ s = Φ t. -/
def OrderNS {D V U : Type} (S : Scale U) (lt : V → V → Prop) (Φ : D → V) (y : D → U) :
    Prop :=
  ∀ s t, (lt (Φ s) (Φ t) ∨ Φ s = Φ t) → S.le (y s) (y t)

theorem mono_chain {D U : Type} (S : Scale U) (P : D → D → Prop) (y : D → U)
    (h : MonoAlong S P y) : ∀ s t, Chain P s t → S.le (y s) (y t) := by
  intro s t hc
  induction hc with
  | refl => exact S.le_refl _
  | step _ hP ih => exact S.le_trans _ _ _ ih (h _ _ hP)

/-- The indicator of the set of realizations reachable from `s` along `P`. -/
noncomputable def upInd {D U : Type} (S : Scale U) (P : D → D → Prop) (s : D) : D → U :=
  fun r => if Chain P s r then S.hi else S.lo

theorem upInd_mono {D U : Type} (S : Scale U) (P : D → D → Prop) (s : D) :
    MonoAlong S P (upInd S P s) := by
  intro a b hab
  show S.le (if Chain P s a then S.hi else S.lo) (if Chain P s b then S.hi else S.lo)
  by_cases ha : Chain P s a
  · have hb : Chain P s b := Chain.step ha hab
    rw [if_pos ha, if_pos hb]
    exact S.le_refl _
  · rw [if_neg ha]
    by_cases hb : Chain P s b
    · rw [if_pos hb]; exact S.lo_le_hi
    · rw [if_neg hb]; exact S.le_refl _

theorem upInd_self {D U : Type} (S : Scale U) (P : D → D → Prop) (s : D) :
    upInd S P s s = S.hi :=
  if_pos (Chain.refl s)

theorem upInd_reach {D U : Type} (S : Scale U) (P : D → D → Prop) (s t : D)
    (h : S.le S.hi (upInd S P s t)) : Chain P s t := by
  apply Classical.byContradiction
  intro hn
  have h0 : upInd S P s t = S.lo := if_neg hn
  rw [h0] at h
  exact S.not_hi_le_lo h

/-- (iii)(b) Order premises entail B for every compatible degree iff the strict order of
Φ is contained in P*. -/
theorem order_cover_B_iff {D V U : Type} (S : Scale U) (lt : V → V → Prop)
    (P : D → D → Prop) (Φ : D → V) :
    (∀ y : D → U, MonoAlong S P y → OrderB S lt Φ y) ↔
      (∀ s t, lt (Φ s) (Φ t) → Chain P s t) := by
  constructor
  · intro h s t hlt
    have hB := h (upInd S P s) (upInd_mono S P s) s t hlt
    rw [upInd_self] at hB
    exact upInd_reach S P s t hB
  · intro h y hy s t hlt
    exact mono_chain S P y hy s t (h s t hlt)

/-- (iii)(c) The same for S_u ∧ B, in its non-strict form. -/
theorem order_cover_SuB_iff {D V U : Type} (S : Scale U) (lt : V → V → Prop)
    (P : D → D → Prop) (Φ : D → V) :
    (∀ y : D → U, MonoAlong S P y → OrderNS S lt Φ y) ↔
      (∀ s t, (lt (Φ s) (Φ t) ∨ Φ s = Φ t) → Chain P s t) := by
  constructor
  · intro h s t hle
    have hB := h (upInd S P s) (upInd_mono S P s) s t hle
    rw [upInd_self] at hB
    exact upInd_reach S P s t hB
  · intro h y hy s t hle
    exact mono_chain S P y hy s t (h s t hle)

/-- (iii)(a) Order premises entail S_u for every compatible degree iff every fibre of Φ
lies in one strongly connected component of P. -/
theorem order_cover_Su_iff {D V U : Type} (S : Scale U) (P : D → D → Prop) (Φ : D → V) :
    (∀ y : D → U, MonoAlong S P y → Suff Φ y) ↔
      (∀ s t, Φ s = Φ t → Chain P s t ∧ Chain P t s) := by
  constructor
  · intro h s t hst
    constructor
    · have he : upInd S P s s = upInd S P s t := h (upInd S P s) (upInd_mono S P s) s t hst
      rw [upInd_self] at he
      apply upInd_reach S P s t
      rw [← he]
      exact S.le_refl _
    · have he : upInd S P t t = upInd S P t s :=
        h (upInd S P t) (upInd_mono S P t) t s hst.symm
      rw [upInd_self] at he
      apply upInd_reach S P t s
      rw [← he]
      exact S.le_refl _
  · intro h y hy s t hst
    have h12 := h s t hst
    exact S.le_antisymm _ _ (mono_chain S P y hy s t h12.1) (mono_chain S P y hy t s h12.2)

/-- Symmetric closure of a relation. -/
def SymC {D : Type} (R : D → D → Prop) : D → D → Prop := fun a b => R a b ∨ R b a

theorem chain_symm {D : Type} (R : D → D → Prop) :
    ∀ a b, Chain (SymC R) a b → Chain (SymC R) b a := by
  intro a b h
  induction h with
  | refl => exact Chain.refl _
  | step _ hyz ih =>
    have hzy : SymC R _ _ := Or.elim hyz (fun h => Or.inr h) (fun h => Or.inl h)
    exact chain_prepend hzy ih

/-- P* for P = R ∪ R⁻¹ is the generated equivalence ⟨R⟩. -/
theorem chain_eqv_iff {D : Type} (R : D → D → Prop) (a b : D) :
    Chain (SymC R) a b ↔ Eqv R a b := by
  constructor
  · intro h
    induction h with
    | refl => exact Eqv.refl _
    | step _ hP ih =>
      cases hP with
      | inl hr => exact Eqv.trans ih (Eqv.rel hr)
      | inr hr => exact Eqv.trans ih (Eqv.symm (Eqv.rel hr))
  · intro h
    induction h with
    | rel hr => exact Chain.step (Chain.refl _) (Or.inl hr)
    | refl x => exact Chain.refl x
    | symm _ ih => exact chain_symm R _ _ ih
    | trans _ _ ih1 ih2 => exact chain_trans ih1 ih2

/-- A degree respects R iff it does not decrease along R ∪ R⁻¹. -/
theorem respects_iff_monoSym {D U : Type} (S : Scale U) (R : D → D → Prop) (y : D → U) :
    Respects R y ↔ MonoAlong S (SymC R) y := by
  constructor
  · intro h s t hst
    cases hst with
    | inl hr => rw [h s t hr]; exact S.le_refl _
    | inr hr => rw [h t s hr]; exact S.le_refl _
  · intro h s t hr
    exact S.le_antisymm _ _ (h s t (Or.inl hr)) (h t s (Or.inr hr))

/-- Theorem 19 of the paper as the case P = R ∪ R⁻¹ of (iii)(a), for degrees in a scale. -/
theorem theorem19_from_order {D V U : Type} (S : Scale U) (R : D → D → Prop) (Φ : D → V) :
    (∀ y : D → U, Respects R y → Suff Φ y) ↔ (∀ s t, Φ s = Φ t → Eqv R s t) := by
  have e1 : (∀ y : D → U, Respects R y → Suff Φ y) ↔
      (∀ y : D → U, MonoAlong S (SymC R) y → Suff Φ y) := by
    constructor
    · intro h y hy; exact h y ((respects_iff_monoSym S R y).2 hy)
    · intro h y hy; exact h y ((respects_iff_monoSym S R y).1 hy)
  rw [e1, order_cover_Su_iff]
  constructor
  · intro h s t hst
    exact (chain_eqv_iff R s t).1 (h s t hst).1
  · intro h s t hst
    exact ⟨(chain_eqv_iff R s t).2 (h s t hst),
      (chain_eqv_iff R t s).2 (Eqv.symm (h s t hst))⟩

/-- Definition 5(a): S_u ∧ B is equivalent to the non-strict implication. -/
theorem suff_and_B_iff_nonstrict {D V U : Type} (S : Scale U) (lt : V → V → Prop)
    (Φ : D → V) (y : D → U) :
    (Suff Φ y ∧ OrderB S lt Φ y) ↔ OrderNS S lt Φ y := by
  constructor
  · intro hSB s t h
    cases h with
    | inl hlt => exact hSB.2 s t hlt
    | inr heq => rw [hSB.1 s t heq]; exact S.le_refl _
  · intro h
    refine ⟨?_, ?_⟩
    · intro s t heq
      exact S.le_antisymm _ _ (h s t (Or.inr heq)) (h t s (Or.inr heq.symm))
    · intro s t hlt
      exact h s t (Or.inl hlt)

/-- `v` lies in the image Φ(D). -/
def InIm {D V : Type} (Φ : D → V) (v : V) : Prop := ∃ s, Φ s = v

/-- Definition 3(e): S holds iff y factors through Φ. -/
theorem suff_iff_factor {D V U : Type} (u0 : U) (Φ : D → V) (y : D → U) :
    Suff Φ y ↔ ∃ h : V → U, ∀ s, y s = h (Φ s) := by
  constructor
  · intro hS
    refine ⟨fun v => if hv : InIm Φ v then y (Classical.choose hv) else u0, ?_⟩
    intro s
    have hv : InIm Φ (Φ s) := ⟨s, rfl⟩
    show y s = (if hv : InIm Φ (Φ s) then y (Classical.choose hv) else u0)
    rw [dif_pos hv]
    exact hS _ _ (Classical.choose_spec hv).symm
  · intro hfac s t hst
    obtain ⟨h, hf⟩ := hfac
    rw [hf s, hf t, hst]

/-- The factor is unique on the image. -/
theorem factor_unique_on_image {D V U : Type} (Φ : D → V) (y : D → U) (h h' : V → U)
    (hf : ∀ s, y s = h (Φ s)) (hf' : ∀ s, y s = h' (Φ s)) : ∀ v, InIm Φ v → h v = h' v := by
  intro v hv
  obtain ⟨s, hs⟩ := hv
  rw [← hs, ← hf s, ← hf' s]

/-- Given a factorization y = h ∘ Φ, B holds iff h is nondecreasing on Φ(D). -/
theorem orderB_iff_monotone_factor {D V U : Type} (S : Scale U) (lt : V → V → Prop)
    (Φ : D → V) (y : D → U) (h : V → U) (hfac : ∀ s, y s = h (Φ s)) :
    OrderB S lt Φ y ↔ (∀ a b, InIm Φ a → InIm Φ b → lt a b → S.le (h a) (h b)) := by
  constructor
  · intro hB a b ha hb hab
    obtain ⟨s, hs⟩ := ha
    obtain ⟨t, ht⟩ := hb
    have hst : lt (Φ s) (Φ t) := by rw [hs, ht]; exact hab
    have := hB s t hst
    rw [hfac s, hfac t, hs, ht] at this
    exact this
  · intro hm s t hlt
    rw [hfac s, hfac t]
    exact hm _ _ ⟨s, rfl⟩ ⟨t, rfl⟩ hlt

/-- Definition 5(b): S_u ∧ B iff y = h ∘ Φ with h nondecreasing on Φ(D). This is a
reformulation of S_u ∧ B, not a derivation of it. -/
theorem suffB_iff_monotone_factor {D V U : Type} (S : Scale U) (lt : V → V → Prop)
    (Φ : D → V) (y : D → U) :
    (Suff Φ y ∧ OrderB S lt Φ y) ↔
      ∃ h : V → U, (∀ s, y s = h (Φ s)) ∧
        (∀ a b, InIm Φ a → InIm Φ b → lt a b → S.le (h a) (h b)) := by
  constructor
  · intro hSB
    obtain ⟨h, hfac⟩ := (suff_iff_factor S.lo Φ y).1 hSB.1
    exact ⟨h, hfac, (orderB_iff_monotone_factor S lt Φ y h hfac).1 hSB.2⟩
  · intro hex
    obtain ⟨h, hfac, hm⟩ := hex
    exact ⟨(suff_iff_factor S.lo Φ y).2 ⟨h, hfac⟩,
      (orderB_iff_monotone_factor S lt Φ y h hfac).2 hm⟩

/-! ## Part (iv): intervention monotonicity IM_T as an order premise -/

/-- The pairs on which IM_T requires u s ≤ u t: pairs of T that raise Φ. -/
def IMrel {D V : Type} (T : D → D → Prop) (lt : V → V → Prop) (Φ : D → V) :
    D → D → Prop :=
  fun s t => T s t ∧ lt (Φ s) (Φ t)

theorem im_chain {D V : Type} (T : D → D → Prop) (lt : V → V → Prop) (Φ : D → V)
    (htrans : ∀ a b c, lt a b → lt b c → lt a c) :
    ∀ s t, Chain (IMrel T lt Φ) s t → s = t ∨ lt (Φ s) (Φ t) := by
  intro s t h
  induction h with
  | refl => exact Or.inl rfl
  | step _ hP ih =>
    right
    cases ih with
    | inl e => rw [e]; exact hP.2
    | inr hlt => exact htrans _ _ _ hlt hP.2

/-- IM_T entails S_u for every compatible degree iff Φ is injective on D: it never
yields S_u on a fibre with two realizations. -/
theorem im_Su_iff_injective {D V U : Type} (S : Scale U) (T : D → D → Prop)
    (lt : V → V → Prop) (Φ : D → V)
    (hirr : ∀ a, ¬ lt a a) (htrans : ∀ a b c, lt a b → lt b c → lt a c) :
    (∀ y : D → U, MonoAlong S (IMrel T lt Φ) y → Suff Φ y) ↔
      (∀ s t, Φ s = Φ t → s = t) := by
  rw [order_cover_Su_iff]
  constructor
  · intro h s t hst
    cases im_chain T lt Φ htrans s t (h s t hst).1 with
    | inl e => exact e
    | inr hlt =>
      rw [hst] at hlt
      exact absurd hlt (hirr _)
  · intro h s t hst
    have e : s = t := h s t hst
    rw [e]
    exact ⟨Chain.refl t, Chain.refl t⟩

/-- IM_T entails B for every compatible degree iff every strict increase of Φ in D is a
chain of Φ-raising pairs of T. -/
theorem im_B_iff {D V U : Type} (S : Scale U) (T : D → D → Prop)
    (lt : V → V → Prop) (Φ : D → V) :
    (∀ y : D → U, MonoAlong S (IMrel T lt Φ) y → OrderB S lt Φ y) ↔
      (∀ s t, lt (Φ s) (Φ t) → Chain (IMrel T lt Φ) s t) :=
  order_cover_B_iff S lt (IMrel T lt Φ) Φ

/-! ## Part (v): descent along a relation `sim` (condition O for ∼_phys) -/

/-- Componentwise form of O. -/
theorem descent_componentwise {I D : Type} {C W : I → Type}
    (x : (i : I) → D → C i) (d : (i : I) → D → W i) (sim : D → D → Prop)
    (hS : ∀ i, Suff (d i) (x i)) (hinv : ∀ i s t, sim s t → d i s = d i t) :
    ∀ s t, sim s t → ∀ i, x i s = x i t :=
  fun s t hst i => hS i s t (hinv i s t hst)

/-- O: the phenomenal tuple e(s) = (x i s)_i is invariant under `sim`. -/
theorem descent_of_suff {I D : Type} {C W : I → Type}
    (x : (i : I) → D → C i) (d : (i : I) → D → W i) (sim : D → D → Prop)
    (hS : ∀ i, Suff (d i) (x i)) (hinv : ∀ i s t, sim s t → d i s = d i t) :
    ∀ s t, sim s t → (fun i => x i s) = (fun i => x i t) := by
  intro s t hst
  funext i
  exact hS i s t (hinv i s t hst)

/-- Without the invariance of a reduced input, its sufficiency does not give O for that
component: some function of `d` separates a `sim`-pair. -/
theorem descent_needs_invariance {D V X : Type} (d : D → V) (a b : X) (hab : a ≠ b)
    (s t : D) (hd : d s ≠ d t) : ∃ y : D → X, Suff d y ∧ y s ≠ y t := by
  refine ⟨fun r => if d r = d s then a else b, ?_, ?_⟩
  · intro r r' hrr'
    show (if d r = d s then a else b) = (if d r' = d s then a else b)
    rw [hrr']
  · show (if d s = d s then a else b) ≠ (if d t = d s then a else b)
    rw [if_pos rfl, if_neg (fun h => hd h.symm)]
    exact hab

/-- Exactness: sufficiency yields invariance on `sim`-pairs for every compatible
component iff the reduced input is invariant under `sim`. -/
theorem descent_exact_iff {D V X : Type} (d : D → V) (sim : D → D → Prop) (a b : X)
    (hab : a ≠ b) :
    (∀ y : D → X, Suff d y → ∀ s t, sim s t → y s = y t) ↔
      (∀ s t, sim s t → d s = d t) := by
  constructor
  · intro h s t hst
    apply Classical.byContradiction
    intro hd
    obtain ⟨y, hy, hne⟩ := descent_needs_invariance d a b hab s t hd
    exact hne (h y hy s t hst)
  · intro h y hy s t hst
    exact hy s t (h s t hst)

/-- O as descent: the assignment is invariant under `sim` iff it factors through the
quotient by `sim`. -/
theorem descent_iff_factor {D E : Type} (sim : D → D → Prop) (e : D → E) :
    (∀ s t, sim s t → e s = e t) ↔
      ∃ ebar : Quot sim → E, ∀ s, e s = ebar (Quot.mk sim s) := by
  constructor
  · intro h
    exact ⟨Quot.lift e h, fun _ => rfl⟩
  · intro hex s t hst
    obtain ⟨ebar, hf⟩ := hex
    rw [hf s, hf t]
    exact congrArg ebar (Quot.sound hst)

/-! ## Assembly: premises ⊢ S_i for every component, B and O -/

/-- The five components of Q (any index type can be used in the theorems above). -/
inductive Comp
  | c | q | u | tau | sigma

/-- Conditional discharge: bridge premises with coverage for every component, an order
premise with order coverage for the unity component, and invariance of every reduced
input under `sim` give every S_i, the order clause B and condition O. The premises are
not justified here. -/
theorem conditional_discharge {I D : Type} {C W : I → Type}
    (x : (i : I) → D → C i) (d : (i : I) → D → W i)
    (R : I → D → D → Prop) (hbridge : ∀ i, Respects (R i) (x i))
    (hcover : ∀ i s t, d i s = d i t → Eqv (R i) s t)
    (iu : I) (S : Scale (C iu)) (lt : W iu → W iu → Prop) (P : D → D → Prop)
    (hmono : MonoAlong S P (x iu)) (hocover : ∀ s t, lt (d iu s) (d iu t) → Chain P s t)
    (sim : D → D → Prop) (hinv : ∀ i s t, sim s t → d i s = d i t) :
    (∀ i, Suff (d i) (x i)) ∧ OrderB S lt (d iu) (x iu) ∧
      (∀ s t, sim s t → (fun i => x i s) = (fun i => x i t)) := by
  have hS : ∀ i, Suff (d i) (x i) :=
    fun i => suff_of_cover (R i) (d i) (x i) (hbridge i) (hcover i)
  exact ⟨hS, (order_cover_B_iff S lt P (d iu)).2 hocover (x iu) hmono,
    descent_of_suff x d sim hS hinv⟩

/-- Non-vacuity of the assembly with I = Comp and integer values: a model on `Fin 3` in which
all five components take the values 0, 0, 5 and their reduced inputs the values 0, 0, 1, the
bridge relation relates the realizations 0 and 1 only, and `P` relates the realizations below 2
to 2. The statement records that the premises hold, that `u` is not constant, and that the
bridge relation of `u` relates two distinct realizations. -/
theorem conditional_discharge_nonvacuous :
    ∃ (D : Type) (d : Comp → D → Nat) (x : Comp → D → Int) (R : Comp → D → D → Prop)
      (P : D → D → Prop),
      (∀ i, Respects (R i) (x i)) ∧ (∀ i s t, d i s = d i t → Eqv (R i) s t) ∧
      MonoAlong intScale P (x Comp.u) ∧
      (∀ s t, d Comp.u s < d Comp.u t → Chain P s t) ∧
      (∃ s t, x Comp.u s ≠ x Comp.u t) ∧ (∃ s t, R Comp.u s t ∧ s ≠ t) := by
  have hcov : ∀ s t : Fin 3,
      (if s.val = 2 then 1 else 0 : Nat) = (if t.val = 2 then 1 else 0 : Nat) →
        (s = t ∨ (s.val = 0 ∧ t.val = 1) ∨ (t.val = 0 ∧ s.val = 1)) := by decide
  have hord : ∀ s t : Fin 3,
      (if s.val = 2 then 1 else 0 : Nat) < (if t.val = 2 then 1 else 0 : Nat) →
        (t.val = 2 ∧ s.val ≠ 2) := by decide
  refine ⟨Fin 3, fun _ s => if s.val = 2 then 1 else 0,
    fun _ s => if s.val = 2 then 5 else 0,
    fun _ s t => s.val = 0 ∧ t.val = 1,
    fun s t => t.val = 2 ∧ s.val ≠ 2, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i s t h
    show (if s.val = 2 then (5 : Int) else 0) = (if t.val = 2 then (5 : Int) else 0)
    rw [h.1, h.2]
    rfl
  · intro i s t h
    rcases hcov s t h with e | r | r
    · rw [e]; exact Eqv.refl t
    · exact Eqv.rel r
    · exact Eqv.symm (Eqv.rel r)
  · intro s t h
    show (if s.val = 2 then (5 : Int) else 0) ≤ (if t.val = 2 then (5 : Int) else 0)
    rw [if_neg h.2, if_pos h.1]
    decide
  · intro s t h
    exact Chain.step (Chain.refl s) (hord s t h)
  · exact ⟨⟨0, by decide⟩, ⟨2, by decide⟩, by decide⟩
  · exact ⟨⟨0, by decide⟩, ⟨1, by decide⟩, ⟨rfl, rfl⟩, by decide⟩

end CondicionalQ

